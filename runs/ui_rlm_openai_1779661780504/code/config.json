{
  "_comment": "PPO hyperparameters for CartPole-v1 reproduction (Schulman et al. 2017)",
  "_assumptions": {
    "ENV001": "pytorch==2.2.0 (inferred from paper date and compatibility)",
    "ENV002": "Python 3.11",
    "ENV003": "CPU-only (CartPole does not require GPU)"
  },

  "total_timesteps": 500000,
  "learning_rate": 3e-4,
  "batch_size": 64,

  "n_steps": 2048,
  "n_epochs": 10,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_coef": 0.2,
  "ent_coef": 0.0,
  "vf_coef": 0.5,
  "max_grad_norm": 0.5,
  "hidden_size": 64,
  "seed": 42,

  "eval_episodes": 100,
  "eval_interval": 10000
}
